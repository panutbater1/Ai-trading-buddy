# Copy this file to .env and fill in your own keys.
# .env is listed in .gitignore, so it never gets uploaded to GitHub.

# Finnhub market data API key (https://finnhub.io/dashboard)
FINNHUB_API_KEY=

# Anthropic API key for Claude (https://console.anthropic.com/settings/keys)
# Optional: if empty, Pip uses the key pasted in the extension's Settings tab.
ANTHROPIC_API_KEY=

# Port for the local backend (server.py). The extension expects 8787.
PORT=8787
